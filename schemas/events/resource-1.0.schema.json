{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform93.dev/schemas/events/resource/1.0",
  "title": "Platform93 OAuth Resource Event Data",
  "description": "Version 1.0 data for resource.created and resource.updated. Only resource identity and configuration version are public.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_id", "version"],
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "examples": [
    { "resource_id": "01900000-0000-7000-8000-000000000004", "version": 1 },
    { "resource_id": "01900000-0000-7000-8000-000000000004", "version": 2 }
  ]
}
