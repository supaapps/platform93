{
  "name": "@supaapps/platform93-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Generated API client for Platform93",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/supaapps/platform93.git",
    "directory": "sdk/typescript/sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "openapi-ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "^5.9.2"
  }
}
